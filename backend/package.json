  "version": "1.0.0",
  "description": "FabricGen Backend - AI-powered Nigerian fashion concept generation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
